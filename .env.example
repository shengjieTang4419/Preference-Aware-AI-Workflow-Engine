# ============================================
# Claude 配置
# ============================================
# 支持两种模式：
#
# 模式1: 原生 Claude API
#   CLAUDE_BASE_URL=https://api.anthropic.com/v1
#   CLAUDE_MODEL_PREFIX=anthropic/
#
# 模式2: xiaomimimo.com 平台 (Anthropic 兼容)
#   CLAUDE_BASE_URL=https://api.xiaomimimo.com/anthropic/v1
#   CLAUDE_MODEL_PREFIX=(留空)
#
# 推荐使用 xiaomimimo.com，提供大量免费 token
# ============================================
CLAUDE_API_KEY=your_api_key_here
CLAUDE_BASE_URL=https://api.xiaomimimo.com/anthropic/v1
# 模型前缀：原生 Claude 用 "anthropic/"，xiaomimimo 留空
CLAUDE_MODEL_PREFIX=

# ============================================
# LiteLLM 配置
# ============================================
# 禁用从 GitHub 获取模型价格（中国网络无法访问）
LITELLM_LOCAL_MODEL_COST_MAP=True

# ============================================
# LLM 调试配置
# ============================================
LLM_DEBUG_ENABLED=false
LLM_DEBUG_DIR=
